# Cloudflare Pages headers for memi.yourmemi.app. Nothing loads from anywhere but here and Google's
# sign-in. The app talks to Google Drive, or to the WebDAV server the person types in (any https
# address, hence connect-src https:); scripts still come only from here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; connect-src 'self' https:; frame-src https://accounts.google.com/gsi/; img-src 'self' blob: data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/*.wasm
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache
# The offline worker must always be checked for a new version (it isn't hashed like the rest).
/sw.js
  ! Cache-Control
  Cache-Control: no-cache
