<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into SignPath: project "your-memi" > Artifact configurations > default.
     Signs YourMemi.exe inside the installer, then the installer itself, and only if the
     program says it's "Your Memi" at the version CI passes in. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <msi-file path="YourMemi-*.msi">
    <pe-file path="**/YourMemi.exe" product-name="Your Memi" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
    <authenticode-sign />
  </msi-file>
</artifact-configuration>
